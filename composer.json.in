{
  "name": "rotdrop/nextcloud-bav",
  "description": "Bank Account Validator",
  "type": "project",
  "license": "AGPL",
  "authors": [
    {
      "name": "Claus-Justus Heine"
    }
  ],
  "require": {
    "globalcitizen/php-iban": "^4.0",
    "phpxmlrpc/phpxmlrpc": "^4",
    "rotdrop/bav": "dev-master"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "rotdrop/nextcloud-app-build-system": "dev-composer-package",
    "nextcloud/ocp": "dev-stable35",
    "cweagans/composer-patches": "^2.0",
    "spatie/typescript-transformer": "*",
    "symfony/finder": "^7.3"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/rotdrop/nextcloud-app-build-system.git"
    },
    {
      "type": "path",
      "url": "3rdparty/bav"
    },
    {
      "type": "path",
      "url": "3rdparty/php-index"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "platform": {
      "php": "8.4.0"
    },
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true,
      "cweagans/composer-patches": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "target-directory": "vendor-bin",
      "forward-command": true
    },
    "patches": {
      "nextcloud/ocp": {
        "Fix server version at 35.0.0.0": "vendor/rotdrop/nextcloud-app-build-system/composer-patches/nextcloud/ocp/get-version.patch"
      }
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCP\\": "vendor/nextcloud/ocp/OCP/"
    }
  }
}
