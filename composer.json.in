{
  "name": "rotdrop/nextcloud-bav",
  "description": "Bank Account Validator",
  "type": "project",
  "license": "AGPL",
  "authors": [
    {
      "name": "Claus-Justus Heine"
    }
  ],
  "require": {
    "globalcitizen/php-iban": "^4.0",
    "phpxmlrpc/phpxmlrpc": "^4",
    "rotdrop/bav": "dev-master"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8"
  },
  "repositories": [
    {
      "type": "path",
      "url": "3rdparty/bav"
    },
    {
      "type": "path",
      "url": "3rdparty/php-index"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "platform": {
      "php": "8.4.0"
    },
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\BAV\\": "lib/",
      "OCA\\RotDrop\\Toolkit\\": "php-toolkit/",
      "OCA\\RotDrop\\DevScripts\\PhpToTypeScript\\": "dev-scripts/lib/scripts/php-to-typescript/",
      "Spatie\\TypeScriptTransformer\\": "vendor-bin/typescript-transformer/vendor/spatie/typescript-transformer/src/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "target-directory": "vendor-bin",
      "forward-command": true
    }
  }
}
