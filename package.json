{
  "name": "bav",
  "version": "1.0.0-rc4",
  "description": ">German Bank Account Validator",
  "author": "Claus-Justus Heine <himself@claus-justus-heine.de>",
  "type": "module",
  "scripts": {
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
    "lint": "eslint --ext .js,.ts,.vue src",
    "lint:fix": "eslint --ext .js,.ts,.vue src --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.claus-justus-heine.de/nextcloud/apps/bav.git"
  },
  "keywords": [],
  "license": "agpl",
  "bugs": {
    "url": "https://gitlab.claus-justus-heine.de/nextcloud/apps/bav.git"
  },
  "homepage": "https://gitlab.claus-justus-heine.de/nextcloud/apps/bav.git",
  "devDependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/dialogs": "^7.3.0",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vite-config": "^3.0.0-beta.1",
    "@nextcloud/vue": "^9.8.0",
    "@prettier/plugin-php": "^0.25.0",
    "@rotdrop/nextcloud-vue-components": "file:repositories/rotdrop/nextcloud-vue-components",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "axios": "^1.16.1",
    "bootstrap": "^5.3.8",
    "floating-vue": "^5.2.2",
    "prettier": "^3.9.9",
    "sass": "^1.99.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-svgo": "^3.0.1",
    "vue": "^3.5.34",
    "xml-reader": "^2.4.3",
    "xml2js": "^0.6.2"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 160,
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": [
      "@prettier/plugin-php",
      "@trivago/prettier-plugin-sort-imports"
    ],
    "overrides": [
      {
        "files": "*.php",
        "options": {
          "parser": "php"
        }
      }
    ]
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "allowScripts": {
    "@parcel/watcher": true,
    "core-js": true
  }
}
